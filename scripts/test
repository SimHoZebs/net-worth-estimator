#!/usr/bin/env bash
# Unified test dispatcher: documents the unit vs integration split in one place.
# Unit needs no servers, Docker daemon, or credentials.
# Integration boots servers, Docker images, or a real provider.
# Usage: scripts/test [--unit|--integration|--all|--e2e [e2e opts]|--matrix [matrix opts]|--gate [--no-browser] [--without-backend] [--shards=N]|--help]
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
Usage: scripts/test [--unit|--integration|--all|--e2e [e2e opts]|--matrix [matrix opts]|--gate [--no-browser] [--without-backend] [--shards=N]|--help]

  --unit         go test + vitest + config contract tests (no servers/daemon/credentials)
  --integration  browser integration suite (fixtureapi + Vite over real HTTP)
  --all          --unit then --integration (tests only; not the completion gate:
               lint, typecheck, and build still run separately per TESTING.md)
  --e2e          disposable end-to-end gate: real provider, real images, real
               browser (needs E2E_TEST_MUTATIONS=1, Docker, ~30 min budget;
               pre-release/nightly cadence, not per push). See docs/e2e-gate.md.
  --skip-build   with --e2e: reuse previously built e2e images (warm rerun;
               images only — each run still mints a fresh fixture and ports)
  --cold-build   with --e2e: rebuild images with --no-cache (true cold build)
  --step=name    with --e2e: run one journey step only (fixture/images/stack
               still run; dependent journeys need the full run)
  --timeout=N    with --e2e: wall-clock budget in seconds (default 1800)
  --clean        with --e2e: remove the disposable root even on failure
               (removed on success, kept on failure by default)
  --seed-pack=p  with --e2e: seed one fixture pack into the owner after
               isolation (exact guest and blank checks run first)
  --seed-bulk=s  with --e2e: tagged bulk rows NxM[:seed] beside the owner
  --matrix       integration edge-case matrix: the Go edge-case suite once per
               dataset-pack x identity-set combination, then teardown to
               nothing (see docs/integration-edge-gates.md)
  --browser      with --matrix: also run the sharing browser specs per pack
               (fixture user only; duo/full/group journeys stay in Go)
  --packs=A,B    with --matrix: fixture packs (default: base,unicode;
               base means the suite default seed, all means every pack file)
  --identities=A,B
               with --matrix: solo, duo, full (default: full,duo,solo)
  --repeat=N     with --matrix: go test -count for storm repetition (default 1)
  --specs=A,B    with --matrix --browser: browser specs (default: the three
               sharing specs)
  --bulk=NxM[:s] with --matrix: tagged bulk accounts on top of each pack
               (default: none; for example 20x200:7)
  --gate         full completion gate: install check, one API generation, then
               backend, frontend, and extension gates in parallel groups,
               then the sharded integration suite
  --no-browser   with --gate: skip the integration suite (fast run)
  --without-backend
                 with --gate: skip the backend group (CI runs it as its own job)
  --shards=N     with --gate: integration shards (default: TEST_BROWSER_SHARDS or CPU/2, max 4)
  --help         this message

Matrix:
  unit         backend/scripts/verify.sh (CGO_ENABLED=0 gofmt+vet+test ./...)
               bun --filter ./frontend test:unit (vitest: src/** and scripts/**, jsdom)
               bun --filter ./extension test (node:test, no external APIs)
               node --test dev/*.test.mjs auth/casdoor/*.test.mjs (Compose CLI, no daemon)
               node --test auth/e2e-gate.test.mjs (e2e budget/flake/fixture contract)
  integration  bun --filter ./frontend test:integration (tests/integration/*.spec.ts, sharded)
               bun --filter ./extension test:browser (disposable browser profile)
  e2e          E2E_TEST_MUTATIONS=1 node auth/test-e2e.mjs (disposable provider,
               real images, real browser; covers the manual credential-gated
               regressions: auth/test-integration.mjs journeys, smoke scripts,
               proxy-header and deployment-image checks,
               migration-on-image verification)
               INTEGRATION_PACK=<pack> seeds the fixture harness from
                 backend/testdata/integration/v1 for any integration run
  edge-matrix  scripts/test --matrix: INTEGRATION_PACK x
               INTEGRATION_IDENTITY_SET over backend/internal/integrationedge
               (throwaway SQLite per test, httptest HTTP, teardown to nothing)
               Manual, credential-gated (not in this dispatcher):
                 physical passkeys and phone recovery (docs/authentication.md
                 checklist); any production mutation (never gated, never run)
EOF
}

run_unit() {
  node scripts/check-install.mjs
  backend/scripts/verify.sh
  # No pre-hooks: generate the API client explicitly and once.
  bun --filter ./frontend api:generate
  bun --filter ./frontend test:unit
  bun --filter ./extension test
  # shellcheck disable=SC2086
  node --test dev/*.test.mjs auth/casdoor/*.test.mjs
  node --test auth/e2e-gate.test.mjs
}

run_integration() {
  bun --filter ./frontend test:integration
  bun --filter ./extension test:browser
}

run_e2e() {
  # shellcheck disable=SC2086
  : "${E2E_TEST_MUTATIONS:?Set E2E_TEST_MUTATIONS=1 to confirm the disposable-only run}"
  node auth/test-e2e.mjs $e2e_args
}
# Integration edge-case matrix: one Go suite run per dataset-pack x
# identity-set combination. Each run uses throwaway SQLite databases and
# httptest HTTP only: no canonical stack, no fixed ports, nothing to tear
# down beyond the test temp dirs. With --browser, the sharing specs also run
# per pack against the pack-seeded fixture harness (fresh temp database and
# random free ports per run, pruned on exit by the browser config).
run_matrix() {
  local packs="$1" identities="$2" repeat="$3" browser="$4" specs="$5" bulk="$6"
  local failed=0 total=0
  local pack identity
  local old_ifs="$IFS"
  IFS=,
  # shellcheck disable=SC2162
  for pack in $packs; do
    for identity in $identities; do
      total=$((total + 1))
      echo "matrix: pack=${pack} identities=${identity} repeat=${repeat} bulk=${bulk:-none}"
      if [ "$pack" = "base" ]; then
        unset INTEGRATION_PACK
      else
        INTEGRATION_PACK="$pack"
        export INTEGRATION_PACK
      fi
      export INTEGRATION_IDENTITY_SET="$identity"
      if [ -n "$bulk" ]; then
        INTEGRATION_BULK="$bulk"
        export INTEGRATION_BULK
      else
        unset INTEGRATION_BULK
      fi
      if CGO_ENABLED=0 go -C backend test ./internal/integrationedge/ ./internal/integrationfixtures/ -count="$repeat"; then
        echo "matrix: ok pack=${pack} identities=${identity}"
      else
        echo "matrix: FAIL pack=${pack} identities=${identity}"
        failed=$((failed + 1))
      fi
      if [ "$browser" -eq 1 ]; then
        if [ "$pack" = "base" ]; then
          unset INTEGRATION_PACK
        else
          INTEGRATION_PACK="$pack"
          export INTEGRATION_PACK
        fi
        if [ -n "$bulk" ]; then
          INTEGRATION_BULK="$bulk"
          export INTEGRATION_BULK
        else
          unset INTEGRATION_BULK
        fi
        # shellcheck disable=SC2086
        if bun --filter ./frontend test:integration -- $specs; then
          echo "matrix: ok browser pack=${pack}"
        else
          echo "matrix: FAIL browser pack=${pack}"
          failed=$((failed + 1))
        fi
      fi
    done
  done
  IFS="$old_ifs"
  unset INTEGRATION_PACK INTEGRATION_IDENTITY_SET INTEGRATION_BULK
  echo "matrix: ${total} combination(s), ${failed} failure(s)"
  if [ "$failed" -ne 0 ]; then
    exit 1
  fi
}


# Full completion gate. Frontend gates run in sequence because they share
# generated API files. The backend (unless CI runs it as its own job),
# extension, and frontend groups run at the same time. Browser shards start
# only after those pass, because each shard also starts a Go server and a Vite
# server.
run_gate() {
  local run_browser="$1" shards="$2" run_backend="$3"
  # Global on purpose: cleanup_logs runs on EXIT, after run_gate returns.
  logs="$(mktemp -d "${TMPDIR:-/tmp}/waypoint-gate.XXXXXX")"
  cleanup_logs() {
    if [ -n "${KEEP_GATE_LOGS:-}" ]; then
      echo "gate: logs kept at $logs"
    else
      rm -rf "$logs"
    fi
  }
  trap cleanup_logs EXIT

  local names=() pids=() started=()
  local failed=0

  start() {
    local name="$1"
    shift
    names+=("$name")
    started+=("$SECONDS")
    "$@" >"$logs/$name.log" 2>&1 &
    pids+=("$!")
  }

  report() {
    local index="$1" code="$2"
    local name="${names[$index]}"
    local elapsed=$((SECONDS - started[$index]))
    if [ "$code" -eq 0 ]; then
      printf '  ok    %s (%ss)\n' "$name" "$elapsed"
      return
    fi
    printf '  FAIL  %s (%ss)\n' "$name" "$elapsed"
    tail -40 "$logs/$name.log" | sed 's/^/        /'
    failed=1
  }

  echo "gate: install drift"
  node scripts/check-install.mjs

  echo "gate: generating API client up front"
  bun --filter ./frontend api:generate >/dev/null

  if [ "$run_backend" -eq 1 ]; then
    echo "gate: backend, frontend, extension"
    start backend backend/scripts/verify.sh
  else
    echo "gate: frontend, extension"
  fi
  start extension bash -c "bun --filter ./extension test && bun --filter ./extension lint && bun --filter ./extension build"
  start frontend-lint bun --filter ./frontend lint
  start frontend-checks bash -c "bun --filter ./frontend typecheck && bun --filter ./frontend test:unit && bun --filter ./frontend build"

  local index
  for index in "${!pids[@]}"; do
    if wait "${pids[$index]}"; then
      report "$index" 0
    else
      report "$index" 1
    fi
  done

  if [ "$run_browser" -eq 1 ]; then
    if [ "$failed" -ne 0 ]; then
      echo "gate: skipping integration suite because other gates failed"
    else
      echo "gate: integration suite"
      if [ -n "$shards" ]; then
        export TEST_BROWSER_SHARDS="$shards"
      fi
      local integration_started=$SECONDS
      if ! bun --filter ./frontend test:integration >"$logs/integration.log" 2>&1; then
        names+=(integration)
        started+=("$integration_started")
        report "$((${#names[@]} - 1))" 1
      else
        names+=(integration)
        started+=("$integration_started")
        report "$((${#names[@]} - 1))" 0
      fi
    fi
  fi

  if [ "$failed" -ne 0 ]; then
    echo "gate: failed"
    exit 1
  fi
  echo "gate: passed"
}

mode=""
run_browser=1
run_backend=1
shards=""
e2e_args=""
matrix_browser=0
matrix_packs="base,unicode"
matrix_identities="full,duo,solo"
matrix_repeat=1
matrix_specs="groupSharing.spec.ts sharedFeed.spec.ts inbox.spec.ts"
matrix_bulk=""
matrix_only_opt=0
for argument in "$@"; do
  case "$argument" in
    --unit|--integration|--all|--e2e|--gate|--matrix|--help|-h)
      if [ -n "$mode" ]; then
        echo "error: only one mode flag (use --help)" >&2
        exit 2
      fi
      mode="$argument"
      ;;
    --skip-build|--clean|--cold-build)
      e2e_args="$e2e_args $argument"
      ;;
    --step=*|--timeout=*|--seed-pack=*|--seed-bulk=*)
      e2e_args="$e2e_args $argument"
      ;;
    --no-browser) run_browser=0 ;;
    --without-backend) run_backend=0 ;;
    --shards=*) shards="${argument#--shards=}" ;;
    --browser) matrix_browser=1; matrix_only_opt=1 ;;
    --packs=*) matrix_packs="${argument#--packs=}"; matrix_only_opt=1 ;;
    --identities=*) matrix_identities="${argument#--identities=}"; matrix_only_opt=1 ;;
    --repeat=*) matrix_repeat="${argument#--repeat=}"; matrix_only_opt=1 ;;
    --specs=*) matrix_specs="${argument#--specs=}"; matrix_only_opt=1 ;;
    --bulk=*) matrix_bulk="${argument#--bulk=}"; matrix_only_opt=1 ;;
    *) echo "error: unknown argument '$argument' (use --help)" >&2; exit 2 ;;
  esac
done

case "${mode:---help}" in
  --gate|--help|-h|--matrix) ;;
  --e2e)
    if [ "$run_browser" -eq 0 ] || [ "$run_backend" -eq 0 ] || [ -n "$shards" ] || [ "$matrix_only_opt" -eq 1 ]; then
      echo "error: --no-browser, --without-backend, and --shards need --gate (use --help)" >&2
      exit 2
    fi
    ;;
  *)
    if [ "$run_browser" -eq 0 ] || [ "$run_backend" -eq 0 ] || [ -n "$shards" ] || [ -n "$e2e_args" ] || [ "$matrix_only_opt" -eq 1 ]; then
      echo "error: --no-browser/--without-backend/--shards need --gate, --skip-build/--step/--timeout/--clean/--cold-build/--seed-pack/--seed-bulk need --e2e, --browser/--packs/--identities/--repeat/--specs/--bulk need --matrix (use --help)" >&2
      exit 2
    fi
    ;;
esac

case "${mode:---help}" in
  --help|-h) usage; exit 0 ;;
  --unit) run_unit ;;
  --integration) run_integration ;;
  --all) run_unit; run_integration ;;
  --e2e) run_e2e ;;
  --gate)
    if [ -n "$shards" ] && ! [[ "$shards" =~ ^[1-9][0-9]*$ ]]; then
      echo "error: --shards needs a positive integer" >&2
      exit 2
    fi
    run_gate "$run_browser" "$shards" "$run_backend"
    ;;
  --matrix)
    if ! [[ "$matrix_repeat" =~ ^[1-9][0-9]*$ ]]; then
      echo "error: --repeat needs a positive integer" >&2
      exit 2
    fi
    if [ "$matrix_packs" = "all" ]; then
      matrix_packs="$(ls backend/testdata/integration/v1/*.json | xargs -n1 basename | sed 's/\.json$//' | paste -sd, -)"
    fi
    if [ -z "$matrix_packs" ] || [ -z "$matrix_identities" ]; then
      echo "error: --packs and --identities need values (use --help)" >&2
      exit 2
    fi
    case ",$matrix_identities," in
      *,,*|*[!a-z,]*)
        echo "error: --identities names solo, duo, full separated by commas" >&2
        exit 2
        ;;
    esac
    for identity in ${matrix_identities//,/ }; do
      case "$identity" in
        solo|duo|full) ;;
        *) echo "error: unknown identity set '$identity' (solo, duo, full)" >&2; exit 2 ;;
      esac
    done
    run_matrix "$matrix_packs" "$matrix_identities" "$matrix_repeat" "$matrix_browser" "$matrix_specs" "$matrix_bulk"
    ;;
  *) echo "error: unknown mode '$mode' (use --help)" >&2; exit 2 ;;
esac
