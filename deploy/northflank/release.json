{
  "name": "waypoint-release",
  "description": "Deploy pinned images, stop API writers, run the shared migration on the real volume, then start the API.",
  "apiVersion": "v1.2",
  "arguments": { "RELEASE_SHA": "", "API_IMAGE": "", "IDENTITY_IMAGE": "", "IDENTITY_SERVICE_ID": "", "IDENTITY_DATABASE_ADDON_ID": "" },
  "options": { "autorun": false, "concurrencyPolicy": "queue" },
  "triggers": [
    {
      "kind": "webhook",
      "ref": "release-hook",
      "spec": { "token": "INJECT_PRIVATE_WEBHOOK_TOKEN" }
    }
  ],
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "AddonBackup",
          "ref": "identity-backup",
          "condition": "success",
          "spec": { "addonId": "${args.IDENTITY_DATABASE_ADDON_ID}", "backupType": "dump" }
        },
        {
          "kind": "RunTemplate",
          "ref": "stop-api-writers",
          "condition": "success",
          "spec": {
            "templateType": "template",
            "templateId": "waypoint-api-command",
            "arguments": {
              "variables": [
                {
                  "key": "COMMAND",
                  "value": "/bin/sh -c 'mkdir -p /tmp/waypoint-maintenance; printf \"maintenance\\n\" > /tmp/waypoint-maintenance/readyz; exec busybox-extras httpd -f -p \"$PORT\" -h /tmp/waypoint-maintenance'"
                }
              ]
            }
          }
        },
        {
          "kind": "Release",
          "ref": "deploy-identity-image",
          "condition": "running",
          "timeoutDuration": 600,
          "spec": {
            "type": "registry",
            "origin": { "imagePath": "${args.IDENTITY_IMAGE}" },
            "target": { "id": "${args.IDENTITY_SERVICE_ID}", "type": "service" }
          }
        },
        {
          "kind": "Release",
          "ref": "deploy-maintenance-image",
          "condition": "running",
          "timeoutDuration": 600,
          "spec": {
            "type": "registry",
            "origin": { "imagePath": "${args.API_IMAGE}" },
            "target": { "id": "nwe-api", "type": "service" }
          }
        },
        {
          "kind": "Condition",
          "ref": "await-api-container",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "running",
              "data": { "serviceId": "nwe-api", "timeoutDuration": 600 }
            }
          }
        },
        {
          "kind": "Action",
          "ref": "migrate",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "execute",
              "condition": "running",
              "data": {
                "serviceId": "nwe-api",
                "command": "/bin/sh -c 'test -f \"$NET_WORTH_ESTIMATOR_DB\" && exec /app/migrate.sh'",
                "options": { "dispatchOnly": false },
                "user": "10001",
                "group": "10001"
              }
            }
          }
        },
        {
          "kind": "RunTemplate",
          "ref": "start-api",
          "condition": "success",
          "spec": {
            "templateType": "template",
            "templateId": "waypoint-api-command",
            "arguments": { "variables": [{ "key": "COMMAND", "value": "python /app/northflank-runtime.py" }] }
          }
        }
      ]
    }
  }
}
