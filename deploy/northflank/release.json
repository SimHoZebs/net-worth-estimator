{
  "name": "waypoint-release",
  "description": "Deploy pinned images, hold API writers behind a durable maintenance marker, run the shared migration on the real volume, then restart the API.",
  "apiVersion": "v1.2",
  "arguments": { "RELEASE_SHA": "", "API_IMAGE": "", "IDENTITY_IMAGE": "", "IDENTITY_SERVICE_ID": "", "IDENTITY_DATABASE_ADDON_ID": "" },
  "options": { "autorun": false, "concurrencyPolicy": "queue" },
  "triggers": [
    {
      "kind": "webhook",
      "ref": "release-hook",
      "spec": { "token": "INJECT_PRIVATE_WEBHOOK_TOKEN" }
    }
  ],
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "AddonBackup",
          "ref": "identity-backup",
          "condition": "success",
          "spec": { "addonId": "${args.IDENTITY_DATABASE_ADDON_ID}", "backupType": "dump" }
        },
        {
          "kind": "Condition",
          "ref": "await-api-writers",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "running",
              "data": { "serviceId": "nwe-api", "timeoutDuration": 600 }
            }
          }
        },
        {
          "kind": "Action",
          "ref": "stop-api-writers",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "execute",
              "condition": "running",
              "data": {
                "serviceId": "nwe-api",
                "command": "/bin/sh -c 'touch /data/waypoint-maintenance'",
                "options": { "dispatchOnly": false },
                "user": "10001",
                "group": "10001"
              }
            }
          }
        },
        {
          "kind": "Release",
          "ref": "deploy-maintenance-image",
          "condition": "running",
          "timeoutDuration": 600,
          "spec": {
            "type": "registry",
            "origin": { "imagePath": "${args.API_IMAGE}" },
            "target": { "id": "nwe-api", "type": "service" }
          }
        },
        {
          "kind": "Release",
          "ref": "deploy-identity-image",
          "condition": "running",
          "timeoutDuration": 600,
          "spec": {
            "type": "registry",
            "origin": { "imagePath": "${args.IDENTITY_IMAGE}" },
            "target": { "id": "${args.IDENTITY_SERVICE_ID}", "type": "service" }
          }
        },
        {
          "kind": "Condition",
          "ref": "await-api-container",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "running",
              "data": { "serviceId": "nwe-api", "timeoutDuration": 600 }
            }
          }
        },
        {
          "kind": "Action",
          "ref": "verify-maintenance",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "execute",
              "condition": "running",
              "data": {
                "serviceId": "nwe-api",
                "command": "/bin/sh -c 'body=\"\"; for i in 1 2 3 4; do body=$(busybox wget -qO- -T 2 \"http://127.0.0.1:$PORT/readyz\" 2>/dev/null) && [ \"$body\" = maintenance ] && exit 0; sleep 1; done; echo \"expected maintenance readiness, got: $body\" >&2; exit 1'",
                "options": { "dispatchOnly": false },
                "user": "10001",
                "group": "10001"
              }
            }
          }
        },
        {
          "kind": "Action",
          "ref": "migrate",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "execute",
              "condition": "running",
              "data": {
                "serviceId": "nwe-api",
                "command": "/bin/sh -c 'test -f \"$NET_WORTH_ESTIMATOR_DB\" && exec /app/migrate.sh'",
                "options": { "dispatchOnly": false },
                "user": "10001",
                "group": "10001"
              }
            }
          }
        },
        {
          "kind": "Action",
          "ref": "clear-maintenance",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "execute",
              "condition": "running",
              "data": {
                "serviceId": "nwe-api",
                "command": "/bin/sh -c 'rm -f /data/waypoint-maintenance'",
                "options": { "dispatchOnly": false },
                "user": "10001",
                "group": "10001"
              }
            }
          }
        },
        {
          "kind": "Action",
          "ref": "start-api",
          "spec": {
            "kind": "Service",
            "spec": {
              "type": "restart",
              "condition": "running",
              "data": { "serviceId": "nwe-api", "timeoutDuration": 600 }
            }
          }
        }
      ]
    }
  }
}
