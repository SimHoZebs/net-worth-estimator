erDiagram
    ACCOUNT ||--o{ TRANSACTION : owns
    ACCOUNT ||--o{ RECURRENCE_RULE : schedules
    ACCOUNT ||--o{ CHECKPOINT : has
    ACCOUNT ||--o{ MONTE_CARLO_STATISTIC : summarized_by
    RECURRENCE_RULE |o--o{ TRANSACTION : generates

    ACCOUNT {
        uuid id PK
        string name
        string kind
        decimal min_balance
        decimal max_balance
        string color
        bool enabled
    }
    TRANSACTION {
        uuid id PK
        uuid source_account_id FK
        json destination_account_ids
        int posted_time
        int transaction_time
        json amount_resolution_json
        string source
        uuid projection_slice_id FK
        json event_json
        decimal applied_amount
        string outcome
    }
    RECURRENCE_RULE {
        uuid id PK
        uuid source_account_id FK
        json destinations
        string frequency
        int priority
        json amount_resolution_json
        decimal annual_cap
        date start_date
        date end_date
    }
    CHECKPOINT {
        uuid id PK
        uuid model_account_id FK
        timestamptz observed_at
        decimal balance
        string source
        string provider
    }
    MONTE_CARLO_STATISTIC {
        uuid id PK
        uuid projection_slice_id FK
        uuid account_id FK
        timestamptz as_of_at
        int sample_count
        decimal mean
        decimal median
        decimal p10
        decimal p25
        decimal p50
        decimal p75
        decimal p90
        decimal std_dev
        decimal probability_below_zero
    }
