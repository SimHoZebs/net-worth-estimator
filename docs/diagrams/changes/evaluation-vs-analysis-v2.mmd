flowchart TB
    subgraph IN["Shared Input"]
        MODEL["FinancialModel"]
        CFG["Evaluation Tables
        + ProjectionRuntimeSettings"]
    end

    subgraph PIPE["Shared Projection Pipeline (per request)"]
        PREP["PrepareSimulationRequest"]
        SIM["Simulate"]
        PATH["BuildProjectionPath
        *ProjectionPath"]
    end

    subgraph RUNTIME["Evaluation Runtime"]
        SET["NewEvaluationRuntimeSet"]
        PART["PartitionByKind
        Readers vs Simulators"]
        GUARD["NeedsProjectionPath guard
        nil Timeline → projection-unavailable"]
        EVAL["EvaluatePath per Reader
        over EvaluationTimeline (source-agnostic)
        projected or historical"]
        MERGE["MergeEvaluationResultCollections"]
        TABLES["EvaluationResultTables
        envelopes + diagnostics"]
    end

    subgraph OUT["Renderer and Persistence (unchanged)"]
        RENDER["Shared result renderer
        deterministic + stochastic SSE"]
        OUTPUTS[("7 outputs
        built_revision")]
    end

    subgraph ANA["Background Analysis (separate worker)"]
        WORKER["Analysis Worker
        15s poll · 60s lease · 30s backoff"]
        SNAP["AnalysisSnapshot
        saved bank facts"]
        FIND["analysis_findings
        identity + dismissed/review"]
        FEED["analysis_feedback
        append-only labels"]
        PROM["analysis_promotions
        pattern → schedule"]
    end

    UI["Frontend"]

    MODEL --> PREP
    CFG --> SET
    PREP --> SIM
    SIM --> PATH
    PATH --> SET
    SET --> PART
    PART --> GUARD
    GUARD --> EVAL
    EVAL --> MERGE
    MERGE --> TABLES
    TABLES --> RENDER
    RENDER --> OUTPUTS
    RENDER --> UI

    MODEL --> SNAP
    SNAP --> WORKER
    WORKER --> FIND
    FIND --> FEED
    FIND --> PROM
    FIND -.-> UI

