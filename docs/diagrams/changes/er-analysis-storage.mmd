erDiagram
    ANALYSIS_INPUTS ||--o{ ANALYSIS_RUNS : claims
    ANALYSIS_RUNS ||--o{ ANALYSIS_FINDINGS : produces
    ANALYSIS_FINDINGS ||--o{ ANALYSIS_FEEDBACK : receives
    ANALYSIS_FINDINGS }o--|| TRANSACTION : annotates
    TRANSACTION_SOURCE_FACTS ||--|| TRANSACTION : preserves
    ANALYSIS_PROMOTIONS ||--|| RECURRENCE_RULE : promotes

    ANALYSIS_INPUTS {
        uuid user_id PK
        int revision
    }
    ANALYSIS_RUNS {
        uuid user_id PK
        uuid id PK
        string type
        string version
        int input_revision
        string state
        int lease_until
        string input_json
    }
    ANALYSIS_FINDINGS {
        uuid user_id PK
        uuid id PK
        string analysis_type FK
        uuid transaction_id FK
        string kind
        string detection_json
        uuid run_id FK
        string status
        bool dismissed
    }
    ANALYSIS_FEEDBACK {
        uuid user_id PK
        uuid id PK
        string request_id
        uuid finding_id FK
        uuid run_id FK
        string payload_json
    }
    TRANSACTION_SOURCE_FACTS {
        uuid user_id PK
        uuid transaction_id PK
        string facts_json
    }
    ANALYSIS_PROMOTIONS {
        uuid user_id PK
        string pattern_key PK
        uuid rule_id FK
    }
    TRANSACTION {
        uuid user_id PK
        uuid id PK
        uuid source_account_id FK
        string name
    }
    RECURRENCE_RULE {
        uuid user_id PK
        uuid id PK
        uuid source_account_id FK
    }

    style ANALYSIS_INPUTS fill:#0d2f4f,stroke:#42a5f5
    style ANALYSIS_RUNS fill:#0d2f4f,stroke:#42a5f5
    style ANALYSIS_FINDINGS fill:#0d2f4f,stroke:#42a5f5
    style ANALYSIS_FEEDBACK fill:#0d2f4f,stroke:#42a5f5
    style TRANSACTION_SOURCE_FACTS fill:#0d2f4f,stroke:#42a5f5
    style ANALYSIS_PROMOTIONS fill:#0d2f4f,stroke:#42a5f5
    style TRANSACTION fill:#1d3a24,stroke:#4caf50
    style RECURRENCE_RULE fill:#1d3a24,stroke:#4caf50
