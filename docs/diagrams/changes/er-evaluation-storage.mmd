erDiagram
    PROJECTION_STATE ||--o{ PROJECTION_SLICE : divides_into
    PROJECTION_STATE ||--o{ NET_WORTH_THRESHOLD_OUTPUT : owns
    PROJECTION_STATE ||--o{ ACCOUNT_BALANCE_OUTPUT : owns
    PROJECTION_STATE ||--o{ TRANSACTION_FULFILLMENT_OUTPUT : owns
    PROJECTION_STATE ||--o{ CYCLE_FULFILLMENT_OUTPUT : owns
    PROJECTION_STATE ||--o{ PLANNED_PURCHASES_OUTPUT : owns
    PROJECTION_STATE ||--o{ FINANCIAL_INDEPENDENCE_OUTPUT : owns
    PROJECTION_STATE ||--o{ WHATIF_OUTPUT : owns
    PROJECTION_SLICE ||--o{ TRANSACTION : generates
    PROJECTION_SLICE ||--o{ MONTE_CARLO_STATISTIC : summarizes
    PROJECTION_SLICE ||--o{ PROJECTION_ROW : timeline

    PROJECTION_STATE {
        uuid user_id PK
        uuid id PK
        int revision
        int published_revision
        int dirty_from
        string projection_start
        string horizon_end
        string det_evaluations_json
    }
    PROJECTION_SLICE {
        uuid id PK
        uuid projection_state_id FK
        int from_at
        int to_at
        int built_revision
        string status
    }
    NET_WORTH_THRESHOLD_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        int position
        bool reached
        string first_reached_date
        int built_revision
    }
    ACCOUNT_BALANCE_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        int position
        bool reached
        string first_reached_date
        int built_revision
    }
    TRANSACTION_FULFILLMENT_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        real requested_amount
        real realized_amount
        float completion_rate
        string first_underfulfilled_date
        string events_json
    }
    CYCLE_FULFILLMENT_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        int position
        float budget
        float spent
        bool within_budget
    }
    PLANNED_PURCHASES_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        bool all_funded
        string first_reached_date
    }
    FINANCIAL_INDEPENDENCE_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        string first_coverage_date
        string detail_json
        float prob_success
    }
    WHATIF_OUTPUT {
        uuid user_id PK
        uuid projection_state_id PK
        uuid instance_id PK
        float final_net_worth
        bool all_funded
    }
    TRANSACTION {
        uuid user_id PK
        uuid id PK
        uuid source_account_id FK
        string name
        int posted_time
    }
    MONTE_CARLO_STATISTIC {
        uuid projection_slice_id FK
        uuid account_id FK
        int sample_count
        float median
    }
    PROJECTION_ROW {
        uuid projection_slice_id FK
        string date PK
        string payload
    }

    style PROJECTION_STATE fill:#4a3800,stroke:#ffb300
    style PROJECTION_SLICE fill:#4a3800,stroke:#ffb300
    style NET_WORTH_THRESHOLD_OUTPUT fill:#4a3800,stroke:#ffb300
    style ACCOUNT_BALANCE_OUTPUT fill:#4a3800,stroke:#ffb300
    style TRANSACTION_FULFILLMENT_OUTPUT fill:#4a3800,stroke:#ffb300
    style CYCLE_FULFILLMENT_OUTPUT fill:#4a3800,stroke:#ffb300
    style PLANNED_PURCHASES_OUTPUT fill:#4a3800,stroke:#ffb300
    style FINANCIAL_INDEPENDENCE_OUTPUT fill:#4a3800,stroke:#ffb300
    style WHATIF_OUTPUT fill:#4a3800,stroke:#ffb300
    style TRANSACTION fill:#1d3a24,stroke:#4caf50
    style MONTE_CARLO_STATISTIC fill:#4a3800,stroke:#ffb300
    style PROJECTION_ROW fill:#4a3800,stroke:#ffb300
