erDiagram
    PROJECTION_STATE ||--o{ PROJECTION_SLICE : divides_into
    PROJECTION_STATE {
        uuid id PK
        uuid scope_id
        bigint revision
        bigint published_revision
        int dirty_from
        timestamptz projection_start
        timestamptz horizon_end
        string calendar_timezone
        string engine_version
        int trial_count
        bigint stochastic_seed
        json det_evaluations_json
        json stoch_evaluations_json
    }
    PROJECTION_SLICE {
        uuid id PK
        uuid projection_state_id FK
        int from_at
        int to_at
        bigint built_revision
        string status
    }

    style PROJECTION_STATE fill:#4a3800,stroke:#ffb300
    style PROJECTION_SLICE fill:#1d3a24,stroke:#4caf50
