flowchart TB
    R[("Recurrence Rules")]
    R --> PRE["Recurrence Preprocessor
    registry volatility check"]
    PRE --> TYPE{"Rule behavior"}
    TYPE -->|"Deterministic"| FIX["Fixed or calculated amount"]
    TYPE -->|"Stochastic"| SAMPLE["Sample variable amount
    frozen seed"]
    FIX --> BASE["Baseline Projection Engine
    full window, suffix persisted"]
    SAMPLE --> MC["Monte Carlo Runner
    1,000 trials, stats only"]
    BASE --> BC[("Baseline Checkpoints
    per event date per account")]
    MC --> AC[("Portfolio statistics
    no trial rows")]
    BC --> READ["Unified Projection Reader
    assembles stored plus live history"]
    AC --> READ

