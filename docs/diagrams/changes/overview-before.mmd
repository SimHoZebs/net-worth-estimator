flowchart TB
    subgraph ING["1. Data Ingestion"]
        PROVIDERS["SimpleFIN / Plaid / MX / CSV / Bank"]
        ADAPTER["TransactionProvider Interface + Adapters"]
        MANUAL["Manual Entry"]
        PROVIDERS --> ADAPTER
    end

    subgraph DB["2. Unified Data Model"]
        ACC[("Accounts")]
        TX[("Transactions")]
        RULE[("Recurrence Rules")]
        CP[("Checkpoints")]
        STATS[("Monte Carlo Statistics")]
    end

    ADAPTER --> TX
    MANUAL --> TX

    subgraph PROJECTION["3. Shared Projection Pipeline"]
        PRE["Preprocessor
        Generate and order events"]
        ENGINE["Projection Engine
        Apply events and constraints"]
        MC["Monte Carlo Orchestrator
        Sample stochastic rules"]
        PRE --> ENGINE
        MC -->|"Sampled events per trial"| ENGINE
    end

    ACC --> PRE
    TX -->|"Actual transactions"| PRE
    RULE --> PRE
    RULE -->|"Stochastic configuration"| MC

    ENGINE -->|"Generated transactions"| TX
    ENGINE -->|"Baseline and trial balances"| CP
    ENGINE -->|"Trial results"| AGG["Statistics Aggregator"]
    AGG --> STATS

    subgraph CACHE["4. Incremental Cache Control"]
        JOURNAL[("Change Journal")]
        SLICES[("Projection Slices / Manifest")]
        INVALID["Find first invalid slice
        Recompute suffix"]
        JOURNAL --> INVALID
        SLICES --> INVALID
    end

    ACC --> JOURNAL
    TX -->|"Actual changes"| JOURNAL
    RULE --> JOURNAL
    INVALID --> PRE
    ENGINE --> SLICES

    subgraph EVALUATION["5. Evaluation Plugins"]
        READER["Evaluation Reader"]
        SIM["Evaluation Simulator"]
    end

    subgraph ACCESS["6. Unified Read API"]
        READ["ProjectionReader"]
    end

    TX --> READ
    CP --> READ
    STATS --> READ
    SLICES --> READ

    READ --> READER
    READ --> SIM
    SIM -.->|"Isolated what-if inputs"| PRE
    READ --> UI["Frontend"]
    READER --> UI
    SIM --> UI

    style PROVIDERS fill:#4a3800,stroke:#ffb300
    style TX fill:#4a3800,stroke:#ffb300
    style CP fill:#4a3800,stroke:#ffb300
    style RULE fill:#4a3800,stroke:#ffb300
    style ENGINE fill:#4a3800,stroke:#ffb300
    style MC fill:#4a3800,stroke:#ffb300
    style AGG fill:#4a1414,stroke:#ef5350
    style JOURNAL fill:#4a1414,stroke:#ef5350
    style INVALID fill:#4a3800,stroke:#ffb300
    style SLICES fill:#4a3800,stroke:#ffb300
    style READER fill:#4a3800,stroke:#ffb300
    style READ fill:#4a3800,stroke:#ffb300
    style ACC fill:#1d3a24,stroke:#4caf50
    style STATS fill:#1d3a24,stroke:#4caf50
    style PRE fill:#1d3a24,stroke:#4caf50
    style ADAPTER fill:#1d3a24,stroke:#4caf50
    style MANUAL fill:#1d3a24,stroke:#4caf50
    style SIM fill:#1d3a24,stroke:#4caf50
    style UI fill:#1d3a24,stroke:#4caf50
