erDiagram
    ACCOUNT ||--o{ RECURRENCE_RULE : schedules
    ACCOUNT {
        uuid id PK
        string name
        string currency
        decimal min_value
        decimal max_value
        timestamptz deleted_at
    }
    RECURRENCE_RULE {
        uuid id PK
        uuid account_id FK
        json schedule
        int execution_order
        json amount_resolver
        timestamptz effective_from
        timestamptz effective_until
    }
