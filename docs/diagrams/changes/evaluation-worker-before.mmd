flowchart TB
    subgraph IN["Inputs (unchanged)"]
        MODEL["FinancialModel"]
        CFG["Evaluation Tables
        + ProjectionRuntimeSettings"]
    end

    subgraph PIPE["Shared Projection Pipeline"]
        PREP["PrepareSimulationRequest"]
        SIM["Simulate"]
        PATH["BuildProjectionPath
        *ProjectionPath"]
    end

    subgraph RUNTIME["Evaluation Runtime"]
        SET["NewEvaluationRuntimeSet
        every evaluator extends Evaluator"]
        EVAL["EvaluateDeterministic
        one pass in input order over Timeline (source-agnostic)"]
        TABLES["EvaluationResultTables
        envelopes + diagnostics"]
    end

    subgraph DEFS["Definition types (generic base, no split)"]
        BASE["Evaluator (generic)
        shared hooks"]
        READER["ReaderDefinition
        Evaluator, never simulates"]
        SIMDEF["SimulatorDefinition
        Evaluator, may simulate
        FI · purchases · whatIf"]
    end

    subgraph OUT["Renderer and Persistence (unchanged)"]
        RENDER["Shared result renderer
        deterministic + stochastic SSE"]
        OUTPUTS[("7 outputs
        built_revision")]
    end

    UI["Frontend"]

    MODEL --> PREP
    CFG --> SET
    PREP --> SIM
    SIM --> PATH
    PATH --> SET
    SET --> EVAL
    EVAL --> TABLES
    TABLES --> RENDER
    RENDER --> OUTPUTS
    RENDER --> UI
    BASE --> READER
    BASE --> SIMDEF
    READER --> EVAL
    SIMDEF --> EVAL
    DEFS --> SET

