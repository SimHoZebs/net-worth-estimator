#!/usr/bin/env sh
set -e
start=$(date +%s)

staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.go$' || true)
if [ -z "$staged_go" ]; then
  echo "pre-commit: no staged backend Go files, skipping backend verify."
else
  pkgs=$(echo "$staged_go" | while IFS= read -r f; do dirname "$f"; done | sort -u)
  for dir in $pkgs; do
    if [ "$dir" = "backend" ]; then
      pkg="./..."
    else
      pkg="./${dir#backend/}/..."
    fi
    echo "pre-commit: backend verify $pkg"
    backend/scripts/verify.sh "$pkg"
  done
fi

staged_lint=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' | grep -v '^frontend/node_modules/' | grep -E '\.(ts|tsx)$' || true)
staged_format=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' | grep -v '^frontend/node_modules/' | grep -E '\.(ts|tsx|css|json|html)$' || true)
if [ -z "$staged_lint" ] && [ -z "$staged_format" ]; then
  echo "pre-commit: no staged frontend files, skipping frontend checks."
else
  echo "pre-commit: frontend lint and format check"
  if [ -n "$staged_lint" ]; then
    # Unquoted on purpose: one repo-relative path per line, no spaces in tree.
    # shellcheck disable=SC2086
    npm --prefix frontend exec -- oxlint $staged_lint
  fi
  if [ -n "$staged_format" ]; then
    # shellcheck disable=SC2086
    npm --prefix frontend exec -- oxfmt --check $staged_format
  fi
fi

end=$(date +%s)
echo "pre-commit: done in $((end - start))s"
