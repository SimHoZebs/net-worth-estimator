#!/usr/bin/env sh
set -e
start=$(date +%s)

node scripts/check-install.mjs

staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.go$' || true)
if [ -z "$staged_go" ]; then
  echo "pre-commit: no staged backend Go files, skipping format check."
else
  echo "pre-commit: gofmt check for staged Go files"
  # shellcheck disable=SC2086
  unformatted=$(gofmt -l $staged_go)
  if [ -n "$unformatted" ]; then
    echo "gofmt issues (run gofmt -w):" >&2
    echo "$unformatted" >&2
    exit 1
  fi
fi

staged_lint=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' | grep -v '^frontend/node_modules/' | grep -E '\.(ts|tsx)$' | sed 's|^frontend/||' || true)
staged_format=$(git diff --cached --name-only --diff-filter=ACM | grep '^frontend/' | grep -v '^frontend/node_modules/' | grep -E '\.(ts|tsx|css|json|html)$' | sed 's|^frontend/||' || true)
if [ -z "$staged_lint" ] && [ -z "$staged_format" ]; then
  echo "pre-commit: no staged frontend files, skipping frontend checks."
else
  echo "pre-commit: frontend lint and format check"
  if [ -n "$staged_lint" ]; then
    # Unquoted on purpose: one repo-relative path per line, no spaces in tree.
    # shellcheck disable=SC2086
    (cd frontend && bunx --no-install oxlint $staged_lint)
  fi
  if [ -n "$staged_format" ]; then
    # shellcheck disable=SC2086
    (cd frontend && bunx --no-install oxfmt --check $staged_format)
  fi
fi

end=$(date +%s)
echo "pre-commit: done in $((end - start))s"
