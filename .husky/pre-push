#!/usr/bin/env sh
set -e
start=$(date +%s)

node scripts/check-install.mjs

# One API generation up front; frontend scripts carry no pre-hooks.
bun --filter ./frontend api:generate >/dev/null

backend/scripts/verify.sh ./internal/...
backend/scripts/verify.sh ./cmd/...

echo "pre-push: frontend lint, typecheck, unit tests"
bun --filter ./frontend lint
bun --filter ./frontend typecheck
bun --filter ./frontend test:unit

echo "pre-push: extension unit tests and lint"
bun --filter ./extension test
bun --filter ./extension lint

end=$(date +%s)
echo "pre-push: done in $((end - start))s"
