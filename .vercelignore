# `vercel --prod` from the repo root uploads this directory. The remote build
# needs the frontend tree, programmatic config, and workspace manifests.
# Root-anchored: bare names would also match same-named dirs under frontend/.
node_modules
/frontend/dist
/backend
/auth/*
!/auth/better-auth/
/auth/better-auth/*
!/auth/better-auth/package.json
/dev
/docs
/scripts
/tasks
/tmp
/uploads
/public
/deploy/*.test.mjs
/.git
/.husky
/.opencode
/.vercel
/.env.local
