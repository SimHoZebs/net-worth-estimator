{
	"name": "net-worth-estimator",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"packageManager": "npm@12.0.2",
	"scripts": {
		"dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
		"build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src vite.config.ts",
		"lint:fix": "biome check --write src vite.config.ts",
		"test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
		"test:run": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
		"prepare": "husky"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"papaparse": "^5.5.4",
		"react": "^19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2",
		"tailwind-merge": "^3.6.0",
		"uplot": "^1.6.32",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.2",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"fake-indexeddb": "^6.2.5",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched"
	}
}
