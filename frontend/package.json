{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"description": "A local-first household financial planning workspace with transparent projections and reversible experiments.",
	"keywords": [
		"accessibility",
		"financial-planning",
		"react"
	],
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint & a=$!; bun run lint:typography & b=$!; bun run lint:styles & c=$!; wait $a; ra=$?; wait $b; rb=$?; wait $c; rc=$?; [ \"$ra\" -eq 0 ] && [ \"$rb\" -eq 0 ] && [ \"$rc\" -eq 0 ]",
		"lint:fix": "oxlint --fix && node scripts/lint-style-scale.ts --fix",
		"lint:styles": "node scripts/lint-style-scale.ts & a=$!; node scripts/lint-design-system.ts & b=$!; wait $a; ra=$?; wait $b; rb=$?; [ \"$ra\" -eq 0 ] && [ \"$rb\" -eq 0 ]",
		"lint:typography": "node scripts/lint-typography.ts",
		"typecheck": "bun check & a=$!; bun check -p tests & b=$!; wait $a; ra=$?; wait $b; rb=$?; [ \"$ra\" -eq 0 ] && [ \"$rb\" -eq 0 ]",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"test:integration": "node scripts/test-integration.mjs",
		"api:generate": "orval --config orval.config.ts",
		"openapi:pull": "node scripts/pull-openapi.mjs",
		"build": "bun check && vite build",
		"preview": "vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.2.8",
		"@tanstack/charts": "^1.1.0",
		"@tanstack/react-query": "^5.104.1",
		"class-variance-authority": "^0.7.1",
		"errore": "^0.12.0",
		"lucide-react": "^0.577.0",
		"motion": "^14.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@playwright/test": "^1.58.2",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^30.1.2",
		"orval": "^8.45.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.88.0",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
