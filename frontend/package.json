{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"description": "A local-first household financial planning workspace with transparent projections and reversible experiments.",
	"keywords": [
		"accessibility",
		"financial-planning",
		"react"
	],
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint & a=$!; bun run lint:styles & c=$!; wait $a; ra=$?; wait $c; rc=$?; [ \"$ra\" -eq 0 ] && [ \"$rc\" -eq 0 ]",
		"lint:fix": "oxlint --fix",
		"lint:styles": "node scripts/lint-design-system.ts",
		"typecheck": "bun check & a=$!; bun check -p tests & b=$!; wait $a; ra=$?; wait $b; rb=$?; [ \"$ra\" -eq 0 ] && [ \"$rb\" -eq 0 ]",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"test:integration": "node scripts/test-integration.mjs",
		"api:generate": "orval --config orval.config.ts",
		"openapi:pull": "node scripts/pull-openapi.mjs",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@tanstack/charts": "^1.4.0",
		"@tanstack/react-query": "^5.106.1",
		"@tanstack/react-router": "^1.170.46",
		"class-variance-authority": "^0.7.1",
		"errore": "^0.14.1",
		"lucide-react": "^1.69.0",
		"motion": "^14.9.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "1.65.0",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/router-plugin": "^1.168.48",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^31.0.0",
		"orval": "^8.46.0",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
