{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "A local-first household financial planning workspace with transparent projections and reversible experiments.",
	"keywords": [
		"financial-planning",
		"react",
		"accessibility"
	],
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:browser": "playwright test",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.8",
		"errore": "^0.12.0",
		"lucide-react": "^0.577.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@biomejs/biome": "2.5.6",
		"@playwright/test": "^1.58.2",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
