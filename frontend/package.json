{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"description": "A local-first household financial planning workspace with transparent projections and reversible experiments.",
	"keywords": [
		"accessibility",
		"financial-planning",
		"react"
	],
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint && npm run lint:typography",
		"lint:fix": "oxlint --fix",
		"lint:typography": "node scripts/lint-typography.ts",
		"typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:browser": "playwright test",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.8",
		"@tanstack/react-query": "^5.104.1",
		"errore": "^0.12.0",
		"lucide-react": "^0.577.0",
		"motion": "^14.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"zod": "^4.3.6",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@playwright/test": "^1.58.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"jsdom": "^30.1.2",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"postcss": "^8.5.28",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
