{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": { "@/*": ["./../src/*"] }
	},
	"include": [
		"*.ts",
		"integration/*.ts",
		"../scripts/*.ts",
		"../playwright.config.ts",
		"../vite.config.ts"
	]
}
