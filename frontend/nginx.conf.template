map $http_x_forwarded_proto $forwarded_scheme {
    default $scheme;
    https https;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /v1/projections/stochastic {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }

    location ^~ /v1 {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
        proxy_buffering on;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
        # API JSON gzips ~20x at the backend; re-compress proxied JSON here
        # so slow links benefit even when the backend response arrives
        # uncompressed. SSE stays untouched: its content type never matches.
        gzip on;
        gzip_proxied any;
        gzip_types application/json;
        gzip_min_length 1024;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}

# Optional browser-facing Casdoor alias. Publish this listener only on loopback
# behind HTTPS Serve. The backend accepts only configured provider Host values.
server {
    listen 81;
    server_name _;

    location = /__gateway_healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass ${BACKEND_URL}/v1/auth/provider/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
        proxy_redirect off;
        # Casdoor's branding cookies exceed the default response-header buffer.
        proxy_buffer_size 16k;
        proxy_buffers 4 16k;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
