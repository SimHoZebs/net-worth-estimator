CASDOOR_PUBLIC_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:8080
AUTH_CLIENT_ID=waypoint-local
# Set each secret to a different random value with 16–72 URL-safe characters.
AUTH_CLIENT_SECRET=
CASDOOR_ADMIN_PASSWORD=
CASDOOR_USER_NAME=
CASDOOR_USER_PASSWORD=
# Optional profile data. Grants use the generated subject, never this email.
CASDOOR_USER_EMAIL=
CASDOOR_USER_DISPLAY_NAME=
# Use this private service URL for the combined Compose stack. Native dev may
# omit it and rely on bounded introspection when loopback notifications fail.
CASDOOR_BACKCHANNEL_LOGOUT_URL=http://backend:8787/v1/auth/backchannel-logout
# Override both for a non-1000 host user. Generated files stay mode 0600.
CASDOOR_UID=1000
CASDOOR_GID=1000
# The published port binds to 127.0.0.1 by default. For trusted-LAN plain HTTP,
# set CASDOOR_BIND=0.0.0.0, then use LAN HTTP URLs for CASDOOR_PUBLIC_URL and
# APP_PUBLIC_URL. The operator owns the network boundary: expose plain HTTP
# only on a trusted private LAN. LAN HTTP is password-only in practice;
# browsers block WebAuthn on non-secure HTTP contexts.
# CASDOOR_BIND=0.0.0.0
CASDOOR_PORT=8000
