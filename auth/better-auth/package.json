{
  "name": "@waypoint/auth",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "setup": "bun run src/setup.ts",
    "build": "bun run build.ts",
    "typecheck": "bun check -p tsconfig.json",
    "lint": "../../frontend/node_modules/.bin/oxlint src one-time test-support.ts build.ts && ../../frontend/node_modules/.bin/oxfmt --check src one-time test-support.ts build.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "better-auth": "1.7.18",
    "pg": "8.16.3",
    "webauthn-polyfills": "0.1.7"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.4",
    "@types/bun": "1.3.11",
    "@types/pg": "8.15.6"
  }
}
