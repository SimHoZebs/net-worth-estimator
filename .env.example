# CSV source for the fixture API backend used by browser tests only. The
# server itself never reads it: local state comes from a database backup
# restored to NET_WORTH_ESTIMATOR_DB. Test-only; production never reads
# this variable (see TESTING.md real-data server note).
# NET_WORTH_ESTIMATOR_MODEL_PATH=/path/to/configs

# Comma-separated exact HTTP origins accepted by the Go backend. Entries may
# not contain paths. Requests without an Origin header are unaffected, and
# origin filtering is not write authorization.
# NET_WORTH_ESTIMATOR_ALLOWED_ORIGINS=https://app.example.com

# Read-only kill switch for the Go backend. Unset/empty = writable (dev
# default). Set to 1, true, or yes to reject guarded model-save and SimpleFIN
# trigger requests with 403; session and user permissions still apply.
# NET_WORTH_ESTIMATOR_READ_ONLY=1

# Receipt extraction source. Manual attachments and review work without it.
# The mock uses local synthetic fixtures and makes no external API calls.
# Ordinary deployments default to disabled. The dev stack selects mock.
# NET_WORTH_ESTIMATOR_RECEIPT_SOURCE=disabled

# Better Auth OIDC is required in dev and production.
# Embedded Go Casbin authorizes each user's private data.
# All users, sessions, grants, and logout records share one application database.
# Anonymous traffic resolves to the application guest scope (Casbin viewer).
# Guests can read and project only that guest scope.
# Use the current application database schema.
# For a new installation, run cmd/setupdb --db PATH as a deployment step.
# For a fresh installation, choose a reserved guest subject (guest-<random UUID>)
# without a provider account. Use the same subject for API and authorization setup.
# Provision the guest destination row with the configured issuer and that subject:
# cmd/setupdb --db PATH --issuer ISSUER --subject GUEST_SUBJECT.
# Server startup requires an existing complete schema and never provisions it.
# HTTP origins outside loopback require HTTPS by default. For trusted-LAN
# plain HTTP only, set NET_WORTH_ESTIMATOR_ALLOW_PRIVATE_HTTP=1 on both the
# backend and identity setup. The operator owns the network boundary:
# bind and expose plain HTTP only on a trusted private LAN. LAN HTTP exposes
# passwords, sessions, and financial data to the local network, and passkeys
# require a secure context, so use password login only.
# NET_WORTH_ESTIMATOR_ALLOW_PRIVATE_HTTP=1
# NET_WORTH_ESTIMATOR_DB=/data/net-worth-estimator.db
# NET_WORTH_ESTIMATOR_AUTH_PROVIDER=better-auth
# NET_WORTH_ESTIMATOR_AUTHZ_DB=/data/authorization.db
# NET_WORTH_ESTIMATOR_AUTH_ISSUER=http://localhost:8000
# NET_WORTH_ESTIMATOR_AUTH_INTERNAL_URL=http://auth:8000
# NET_WORTH_ESTIMATOR_AUTH_CLIENT_ID=your-registered-client-id
# NET_WORTH_ESTIMATOR_AUTH_CLIENT_SECRET=your-registered-client-secret
# NET_WORTH_ESTIMATOR_PUBLIC_URL=http://localhost:8080
# NET_WORTH_ESTIMATOR_AUTH_ACCOUNT_URL=http://localhost:8000/account
# Optional additional app -> browser-facing provider addresses. Keep the issuer
# unchanged. Register each app's exact /v1/auth/callback and / URLs during setup.
# NET_WORTH_ESTIMATOR_AUTH_BROWSER_ORIGINS={"https://node.example.ts.net:18081":"https://node.example.ts.net:18083"}
# Resolve anonymous traffic to this application-owned guest subject.
# Persisted Casbin viewer permissions limit access. No provider account is needed.
# Existing installations retain their exact issuer and guest subject during import.
# NET_WORTH_ESTIMATOR_GUEST_SUBJECT=guest-<random UUID>
# Development-only admin observation branch. Names one verified provider subject
# allowed to act on any user resource with that user's own verified permissions
# (Casbin evaluates them live for the target identity). Unset (default) disables
# the branch. Never set in production without the SOP in docs/authorization.md.
# NET_WORTH_ESTIMATOR_ADMIN_SUBJECT=verified-oidc-subject-id
# Minimum log level: debug, info (default), warn, error.
# NET_WORTH_ESTIMATOR_LOG_LEVEL=info
# NET_WORTH_ESTIMATOR_AUTH_SESSION_LIFETIME=168h
# Revocation checks run on the next request after this interval. Range: 1s–5m.
# NET_WORTH_ESTIMATOR_AUTH_RECHECK_INTERVAL=30s

# Better Auth service. Provision explicitly before startup. Never commit secrets.
# AUTH_PUBLIC_URL=https://identity.example.com
# APP_PUBLIC_URL=https://app.example.com
# AUTH_DATABASE=/data/identity.db
# BETTER_AUTH_SECRET=<at-least-32-random-characters>
# AUTH_CLIENT_ID=waypoint
# AUTH_CLIENT_SECRET=<different-at-least-32-random-characters>
# Public Northflank ingress only. Leave unset for direct or unverified proxy paths.
# AUTH_CLIENT_IP_HEADER=x-envoy-external-address

# SimpleFIN Bridge sync. The Bridge key is connected per user through
# POST /v1/sync/simplefin/credential (setup token or access URL); nothing
# in the environment carries the secret. Do not log it; treat transport
# failures as sensitive because their errors can wrap the request URL.

# Split deployment. The frontend proxies /v1 to BACKEND_URL on the same origin.
# See deploy/vercel.md for the Vercel proxy settings.
# BACKEND_URL=http://backend:8787
# BACKEND_PORT=8787
# FRONTEND_PORT=8080
