# Optional source overrides. The tracked public files are the defaults.
# NET_WORTH_ESTIMATOR_MODEL_PATH=/path/to/configs
# NET_WORTH_ESTIMATOR_INCOME_PATH=/path/to/data/income

# Go backend origin proxied by the Vite dev server for /v1 requests
# (default: http://localhost:8787).
# NET_WORTH_ESTIMATOR_BACKEND=http://localhost:8787

# Browser API base URL embedded by Vite at build time. Leave unset to use
# same-origin /v1 routes. Do not include /v1 in this value.
# VITE_API_BASE_URL=https://api.example.com

# Comma-separated exact browser origins accepted by the Go backend at runtime.
# Entries may not contain paths. Requests without an Origin header are unaffected.
# NET_WORTH_ESTIMATOR_ALLOWED_ORIGINS=https://app.example.com

# Read-only kill switch for the Go backend. Unset/empty = writable (dev
# default). Set to 1, true, or yes to reject PUT /v1/financial-model with
# 403; reads and compute stay public.
# NET_WORTH_ESTIMATOR_READ_ONLY=1

# Single bearer token guarding canonical model writes (PUT
# /v1/financial-model). Empty/unset = auth disabled (dev default). Generate
# with a CSPRNG, store in a secret manager, never log it, and serve
# exclusively behind HTTPS: a token captured over plain HTTP permits
# world-write replay. Read-only mode still rejects writes even with a token.
# NET_WORTH_ESTIMATOR_AUTH_TOKEN=replace-with-a-long-random-secret

# SimpleFIN Bridge sync (Plan B). Unset access URL = sync disabled.
# The URL is a secret: store it in a secret manager, never log or share it.
# Restart to rotate. Map SimpleFIN account IDs to model account IDs, and list
# the model accounts treated as cards (pending charges are seeded only for
# these). Dry run logs planned writes without storing anything; use it first.
# NET_WORTH_ESTIMATOR_SIMPLEFIN_ACCESS_URL=https://bridge.simplefin.org/simplefin/claim/...
# NET_WORTH_ESTIMATOR_SIMPLEFIN_ACCOUNTS=sfin-id-1=checking,sfin-id-2=prime_card
# NET_WORTH_ESTIMATOR_SIMPLEFIN_CARDS=prime_card,ultimate_card
# NET_WORTH_ESTIMATOR_SIMPLEFIN_DRY_RUN=1

# SimpleFIN mock interlude (dev-only, temporary). Fabricates Bridge responses
# so the sync can be exercised without credentials; mock rows are identical
# to real sync rows by design. Mutually exclusive with the access URL above.
# Map the stable mock IDs to model accounts, e.g.
# mock-checking=checking,mock-prime=prime_card. Cutover: back up the DB, run
# backend/scripts/purge-simplefin-sync.sql, unset MOCK, set the real URL.
# NET_WORTH_ESTIMATOR_SIMPLEFIN_MOCK=1
# NET_WORTH_ESTIMATOR_SIMPLEFIN_MOCK_FILE=/path/to/mock-accounts.json

# Opt-in live end-to-end tests (src/lib/projection/__tests__/__liveBackend.test.ts).
# Set to 1 with the dev server reachable; skipped otherwise.
# NET_WORTH_ESTIMATOR_LIVE_TESTS=1
