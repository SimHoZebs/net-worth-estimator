# CSV source for the fixture API backend used by browser tests. The server
# itself never reads it: local state comes from a database backup restored
# to NET_WORTH_ESTIMATOR_DB.
# NET_WORTH_ESTIMATOR_MODEL_PATH=/path/to/configs

# Comma-separated exact HTTP origins accepted by the Go backend. Entries may
# not contain paths. Requests without an Origin header are unaffected, and
# origin filtering is not write authorization.
# NET_WORTH_ESTIMATOR_ALLOWED_ORIGINS=https://app.example.com

# Read-only kill switch for the Go backend. Unset/empty = writable (dev
# default). Set to 1, true, or yes to reject guarded model-save and SimpleFIN
# trigger requests with 403; session and plan permissions still apply.
# NET_WORTH_ESTIMATOR_READ_ONLY=1

# Receipt extraction source. Manual attachments and review work without it.
# The mock uses local synthetic fixtures and makes no external API calls.
# Ordinary deployments default to disabled. The dev stack selects mock.
# NET_WORTH_ESTIMATOR_RECEIPT_SOURCE=disabled

# Casdoor OIDC authentication is required in dev and production.
# Casdoor authorizes each account's private plan.
# All plans, sessions, grants, and logout records share one application database.
# Guests can read and project only the optional plans/sample record.
# Legacy financial databases are unsupported; start from a current database.
# For a new installation, run cmd/setupdb --db PATH as a deployment step.
# Server startup requires an existing complete schema and never provisions it.
# NET_WORTH_ESTIMATOR_DB=/data/net-worth-estimator.db
# NET_WORTH_ESTIMATOR_AUTH_PROVIDER=casdoor
# NET_WORTH_ESTIMATOR_AUTH_ISSUER=http://localhost:8000
# NET_WORTH_ESTIMATOR_AUTH_INTERNAL_URL=http://casdoor:8000
# NET_WORTH_ESTIMATOR_AUTH_CLIENT_ID=your-registered-client-id
# NET_WORTH_ESTIMATOR_AUTH_CLIENT_SECRET=your-registered-client-secret
# NET_WORTH_ESTIMATOR_PUBLIC_URL=http://localhost:8080
# NET_WORTH_ESTIMATOR_AUTH_ACCOUNT_URL=http://localhost:8000/account
# Optional additional app -> browser-facing Casdoor addresses. Keep the issuer
# unchanged. Register each app's exact /v1/auth/callback and / URLs in Casdoor.
# NET_WORTH_ESTIMATOR_AUTH_BROWSER_ORIGINS={"https://node.example.ts.net:18081":"https://node.example.ts.net:18083"}
# NET_WORTH_ESTIMATOR_AUTH_PERMISSION_MODEL=waypoint/plan-access
# Bind configured SimpleFIN credentials to this verified owner's private plan.
# NET_WORTH_ESTIMATOR_PLAN_OWNER_SUBJECT=verified-oidc-subject-id
# NET_WORTH_ESTIMATOR_AUTH_SESSION_LIFETIME=168h
# Revocation checks run on the next request after this interval. Range: 1s–5m.
# NET_WORTH_ESTIMATOR_AUTH_RECHECK_INTERVAL=30s

# SimpleFIN Bridge sync. The Bridge key is connected per plan through
# POST /v1/sync/simplefin/credential (setup token or access URL); nothing
# in the environment carries the secret. Do not log it; treat transport
# failures as sensitive because their errors can wrap the request URL.

# Split container deployment. The Compose frontend proxies /v1 to the backend;
# Vercel builds should set VITE_API_BASE_URL to the public API origin.
# VITE_API_BASE_URL=https://api.example.com
# BACKEND_URL=http://backend:8787
# BACKEND_PORT=8787
# FRONTEND_PORT=8080
# NET_WORTH_ESTIMATOR_ALLOWED_ORIGINS=http://localhost:8080
